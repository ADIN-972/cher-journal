    "expo-constants": "~18.0.13",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.23",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "import-local": "^3.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
