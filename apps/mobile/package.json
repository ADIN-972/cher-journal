    "@types/jest": "29.5.14",
    "@types/react": "^19.0.0",
    "eslint": "^10.0.3",
    "eslint-config-expo": "~10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.3.1",
    "jest-mock-extended": "^4.0.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
