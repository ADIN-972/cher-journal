{
  "extends": ["expo", "prettier"],
  "plugins": ["react-native", "react-hooks"],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unused-vars": "off"
  },
  "env": {
    "node": true,
    "es2021": true
  }
}
