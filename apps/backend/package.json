{
  "name": "@cher-journal/backend",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev && npm run backup:db",
    "prisma:seed": "tsx prisma/seeds/index.ts",
    "prisma:studio": "prisma studio",
    "migrate:text-data": "tsx prisma/migrate-text-data.ts",
    "migrate:thumbnails": "tsx scripts/migrate-thumbnails.ts",
    "backup:db": "tsx prisma/scripts/backup-database.ts",
    "restore:db": "tsx prisma/scripts/restore-database.ts",
    "backup:assets": "tsx prisma/scripts/backup-assets.ts",
    "restore:assets": "tsx prisma/scripts/restore-assets.ts",
    "backup:all": "npm run backup:db && npm run backup:assets",
    "restore:all": "npm run restore:db && npm run restore:assets"
  },
  "dependencies": {
    "@cher-journal/config": "*",
    "@cher-journal/types": "*",
    "@cher-journal/utils": "*",
    "@fastify/cookie": "^9.3.1",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.1.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^6.12.0",
    "@prisma/client": "^5.8.0",
    "@types/nodemailer": "^7.0.11",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^4.25.2",
    "fastify-type-provider-zod": "^6.1.0",
    "nodemailer": "^8.0.1",
    "resend": "^6.9.4",
    "sharp": "^0.33.1",
    "stripe": "^14.10.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.10.0",
    "prettier": "^3.7.4",
    "prisma": "^5.8.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
