# Environment
NODE_ENV=development

# Server
PORT=5003
HOST=0.0.0.0

# URLs
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
BACKEND_URL=http://localhost:5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cher_journal_claude

# Session
SESSION_SECRET=change-me-in-production-please-use-strong-secret

# Encryption (KEK - must be at least 32 characters)
MASTER_ENCRYPTION_KEY=dev-only-32-byte-key-change-me!!
# Set to 'false' to disable encryption (dev/demo only)
ENCRYPTION_ENABLED=false

# Stripe
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Upload
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Wait-until-free duration (in milliseconds, default 24h)
WAIT_DURATION_MS=86400000

# Seed data
SEED_ADMIN_EMAIL=admin@cherjournal.com
SEED_ADMIN_PASSWORD=admin123
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=user123

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15 minutes
