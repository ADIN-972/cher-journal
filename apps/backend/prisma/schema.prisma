generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                      @id @default(uuid())
  publicId              String                      @unique @default(uuid())
  email                 String                      @unique
  passwordHash          String
  status                UserStatus                  @default(ACTIVE)
  role                  UserRole                    @default(USER)
  createdAt             DateTime                    @default(now())
  firstName             String
  lastName              String
  username              String?                     @unique
  appliedPromotions     AppliedPromotion[]
  auditLogs             AuditLog[]
  chapterReviews        ChapterReview[]
  entitlements          Entitlement[]
  orders                Order[]
  sessions              Session[]
  subscription          Subscription?
  supportClaims         SupportClaim[]
  unlocks               Unlock[]
  badges                UserBadge[]
  constellationProgress UserConstellationProgress[]
  progress              UserProgress?
  rewardUnlocks         UserRewardUnlock[]
  reads                 VolumeRead[]
  customStoryRequests   CustomStoryRequest[]
  musedChapters         ChapterMuse[]

  @@map("users")
}

model Session {
  id            String   @id @default(uuid())
  userId        String
  sessionToken  String   @unique
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  ipHash        String?
  userAgentHash String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Chapter {
  id                       String                 @id @default(uuid())
  title                    String
  protagonistName          String
  status                   ChapterStatus          @default(DRAFT)
  coverAssetId             String?
  createdAt                DateTime               @default(now())
  publishedAt              DateTime?
  isArchived               Boolean                @default(false)
  isPrivate                Boolean                @default(false)
  scheduledFor             DateTime?
  description              String?
  accroche_classic         String?
  accroche_dark            String?
  accroche_dark_collection String?
  accroche_love            String?
  accroche_marketing       String?
  niveau_danger            Int?                   @default(3)
  niveau_douceur           Int?                   @default(3)
  niveau_intensite         Int?                   @default(3)
  niveau_transformation    Int?                   @default(3)
  bundleItems              BundleItem[]
  assets                   ChapterAsset[]
  constellations           ChapterConstellation[]
  genres                   ChapterGenreTag[]
  priceOverride            ChapterPriceOverride?
  reviews                  ChapterReview[]
  coverAsset               ChapterAsset?          @relation("ChapterCover", fields: [coverAssetId], references: [id])
  entitlements             Entitlement[]
  rewards                  RewardUnlock[]
  unlocks                  Unlock[]
  reads                    VolumeRead[]
  volumes                  Volume[]
  muse                     ChapterMuse?

  @@index([scheduledFor])
  @@map("chapters")
}

model ChapterMuse {
  id              String              @id @default(uuid())
  chapterId       String              @unique
  userId          String
  customStoryId   String?             @unique
  promotionId     String?             @unique
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  chapter         Chapter             @relation(fields: [chapterId], references: [id])
  user            User                @relation(fields: [userId], references: [id])
  customStory     CustomStoryRequest? @relation(fields: [customStoryId], references: [id])
  promotion       Promotion?          @relation(fields: [promotionId], references: [id])

  @@map("chapter_muses")
}

model Volume {
  id                  String                @id @default(uuid())
  chapterId           String
  volumeNumber        Int
  title               String
  isFinalPaywall      Boolean               @default(false)
  illustrationAssetId String?
  createdAt           DateTime              @default(now())
  waitDuration        BigInt                @default(0)
  publishedAt         DateTime?
  isFree              Boolean               @default(false)
  scheduledFor        DateTime?
  status              VolumeStatus          @default(DRAFT)
  charme              Int                   @default(0)
  danger              Int                   @default(0)
  douceur             Int                   @default(0)
  intensite           Int                   @default(0)
  isDarkCollection    Boolean               @default(false)
  mystere             Int                   @default(0)
  transformation      Int                   @default(0)
  xpAmeBase           Int                   @default(0)
  xpFeuBase           Int                   @default(0)
  xpOmbreBase         Int                   @default(0)
  rewards             RewardUnlock[]
  constellations      VolumeConstellation[]
  versions            VolumeVersion[]
  chapter             Chapter               @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  illustrationAsset   ChapterAsset?         @relation("VolumeIllustration", fields: [illustrationAssetId], references: [id])

  @@unique([chapterId, volumeNumber])
  @@index([chapterId])
  @@index([scheduledFor])
  @@map("volumes")
}

model VolumeVersion {
  id                  String         @id @default(uuid())
  volumeId            String
  perspective         Perspective
  illustrationAssetId String?
  createdAt           DateTime       @default(now())
  text                String?
  textBlobId          String?
  isAutoText          Boolean        @default(true)
  characterCount      Int            @default(0)
  assets              VersionAsset[]
  illustrationAsset   ChapterAsset?  @relation("VersionIllustration", fields: [illustrationAssetId], references: [id])
  textBlob            EncryptedBlob? @relation("VersionText", fields: [textBlobId], references: [id])
  volume              Volume         @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, perspective])
  @@index([volumeId])
  @@map("volume_versions")
}

model VersionAsset {
  id              String        @id @default(uuid())
  volumeVersionId String
  assetOrder      Int
  chapterAssetId  String
  createdAt       DateTime      @default(now())
  chapterAsset    ChapterAsset  @relation(fields: [chapterAssetId], references: [id])
  volumeVersion   VolumeVersion @relation(fields: [volumeVersionId], references: [id], onDelete: Cascade)

  @@unique([volumeVersionId, assetOrder])
  @@index([volumeVersionId])
  @@index([chapterAssetId])
  @@map("version_assets")
}

model ChapterAsset {
  id                     String          @id @default(uuid())
  chapterId              String
  kind                   AssetKind       @default(IMAGE)
  label                  String?
  objectKey              String
  mimeType               String
  sizeBytes              Int
  width                  Int?
  height                 Int?
  sha256                 String?
  createdAt              DateTime        @default(now())
  thumbnailObjectKey     String?
  originalAssetId        String?
  updatedAt              DateTime        @default(now()) @updatedAt
  version                Int             @default(1)
  tags                   AssetTagging[]
  chapter                Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  originalAsset          ChapterAsset?   @relation("AssetVersions", fields: [originalAssetId], references: [id])
  versions               ChapterAsset[]  @relation("AssetVersions")
  coverFor               Chapter[]       @relation("ChapterCover")
  versionAssets          VersionAsset[]
  versionIllustrationFor VolumeVersion[] @relation("VersionIllustration")
  illustrationFor        Volume[]        @relation("VolumeIllustration")

  @@index([chapterId])
  @@index([sha256])
  @@index([originalAssetId])
  @@map("chapter_assets")
}

model Order {
  id                      String      @id @default(uuid())
  userId                  String
  type                    OrderType
  status                  OrderStatus @default(PENDING)
  provider                String?
  providerSessionId       String?
  providerPaymentIntentId String?
  currency                String?
  amountTotal             Int?
  createdAt               DateTime    @default(now())
  appliedPriceEpilogue    Int?
  appliedPriceFreeToRead  Int?
  appliedPricePaywall     Int?
  appliedPriceSchemaId    String?
  appliedPromotionId      String?
  refId                   String?
  volumeNumber            Int?
  appliedPromotion        Promotion?  @relation(fields: [appliedPromotionId], references: [id])
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds                 Refund[]

  @@index([userId])
  @@index([refId])
  @@index([type, refId])
  @@map("orders")
}

model Refund {
  id                 String       @id @default(uuid())
  orderId            String
  amountRefunded     Int
  currency           String       @default("eur")
  type               RefundType
  status             RefundStatus @default(PENDING)
  reason             String?
  notes              String?
  providerRefundId   String?
  revokeEntitlements Boolean      @default(true)
  refundedBy         String?
  refundedAt         DateTime     @default(now())
  processedAt        DateTime?
  failureReason      String?
  order              Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

model Entitlement {
  id           String                  @id @default(uuid())
  userId       String
  chapterId    String
  volumeFrom   Int
  volumeTo     Int
  scopes       String[]              @default(["BASE"])
  source       EntitlementSource
  grantedAt    DateTime                @default(now())
  chapter      Chapter                 @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, chapterId])
  @@map("entitlements")
}

model Unlock {
  id           String            @id @default(uuid())
  userId       String
  chapterId    String
  volumeNumber Int
  unlocksAt    DateTime
  triggeredBy  UnlockTriggeredBy
  chapter      Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId, volumeNumber])
  @@index([userId, chapterId])
  @@map("unlocks")
}

model VolumeRead {
  id               String      @id @default(uuid())
  userId           String
  chapterId        String
  volumeNumber     Int
  firstOpenedAt    DateTime    @default(now())
  completedAt      DateTime?
  canStartWaitFrom DateTime?
  progress         Int         @default(0)
  perspective      Perspective @default(NARRATOR)
  chapter          Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId, volumeNumber, perspective])
  @@index([userId, chapterId])
  @@map("volume_reads")
}

model ChapterReview {
  id         String       @id @default(uuid())
  userId     String
  chapterId  String
  rating     Int
  reviewText String
  status     ReviewStatus @default(PENDING)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  chapter    Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
  @@index([status])
  @@map("chapter_reviews")
}

model EncryptedBlob {
  id           String          @id @default(uuid())
  ownerId      String
  purpose      String
  cipherText   Bytes
  iv           Bytes
  tag          Bytes
  wrappedDek   Bytes
  alg          String
  version      Int
  createdAt    DateTime        @default(now())
  versionTexts VolumeVersion[] @relation("VersionText")

  @@index([ownerId, purpose])
  @@map("encrypted_blobs")
}

model WebhookEvent {
  id         String   @id @default(uuid())
  provider   String
  eventId    String   @unique
  type       String
  receivedAt DateTime @default(now())

  @@map("webhook_events")
}

model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @unique
  stripeSubscriptionId String?            @unique
  stripeCustomerId     String?
  status               SubscriptionStatus
  planName             String
  priceAmountCents     Int
  currency             String             @default("EUR")
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  cancelledAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeSubscriptionId])
  @@index([status])
  @@map("subscriptions")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Price {
  id          String         @id @default(uuid())
  scope       PriceScope
  refId       String?
  amountCents Int
  currency    String         @default("EUR")
  createdAt   DateTime       @default(now())
  history     PriceHistory[]
  promotions  Promotion[]

  @@index([scope, refId])
  @@map("prices")
}

model PriceHistory {
  id             String   @id @default(uuid())
  priceId        String
  oldAmountCents Int
  newAmountCents Int
  currency       String   @default("EUR")
  changedAt      DateTime @default(now())
  changedBy      String?
  reason         String?
  price          Price    @relation(fields: [priceId], references: [id], onDelete: Cascade)

  @@index([priceId, changedAt])
  @@index([changedAt])
  @@map("price_history")
}

model Promotion {
  id             String              @id @default(uuid())
  scope          PriceScope
  refId          String?
  type           PromotionType
  value          Int?
  startsAt       DateTime
  endsAt         DateTime
  maxUses        Int?
  perUserLimit   Int?
  isActive       Boolean             @default(true)
  priceId        String?
  createdAt      DateTime            @default(now())
  createdBy      String?
  description    String?
  name           String              @default("Promotion")
  targetCriteria Json?
  targetType     PromotionTargetType @default(ALL_USERS)
  targetUserIds  String[]            @default([])
  updatedAt      DateTime            @default(now()) @updatedAt
  code           String?             @unique
  applied        AppliedPromotion[]
  orders         Order[]
  price          Price?              @relation(fields: [priceId], references: [id])
  museGrant      ChapterMuse?

  @@index([scope, refId])
  @@index([priceId])
  @@index([targetType])
  @@index([isActive, startsAt, endsAt])
  @@index([code])
  @@map("promotions")
}

model AppliedPromotion {
  id           String    @id @default(uuid())
  promotionId  String
  userId       String
  appliedAt    DateTime  @default(now())
  appliedRefId String?
  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([promotionId])
  @@map("applied_promotions")
}

model PriceSchema {
  id                     String                 @id @default(uuid())
  name                   String
  description            String?
  priceFreeToRead        Int                    @default(199)
  pricePaywall           Int                    @default(299)
  priceEpilogue          Int                    @default(399)
  isActive               Boolean                @default(true)
  appliedFrom            DateTime               @default(now())
  appliedTo              DateTime?
  createdAt              DateTime               @default(now())
  createdBy              String
  priceProtagonistUnlock Int                    @default(99)
  chapterOverrides       ChapterPriceOverride[]

  @@index([isActive])
  @@index([appliedFrom])
  @@map("price_schemas")
}

model ChapterPriceOverride {
  id                     String      @id @default(uuid())
  chapterId              String      @unique
  schemaId               String
  priceFreeToRead        Int?
  pricePaywall           Int?
  priceEpilogue          Int?
  reason                 String?
  isActive               Boolean     @default(true)
  appliedFrom            DateTime    @default(now())
  appliedTo              DateTime?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  priceProtagonistUnlock Int?
  chapter                Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  schema                 PriceSchema @relation(fields: [schemaId], references: [id])

  @@index([schemaId])
  @@index([isActive])
  @@map("chapter_price_overrides")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String?
  category    String
  type        String
  description String?
  isEncrypted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?

  @@index([category])
  @@map("system_configs")
}

model AssetTag {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  color       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  assets      AssetTagging[]

  @@map("asset_tags")
}

model AssetTagging {
  id        String       @id @default(uuid())
  assetId   String
  tagId     String
  createdAt DateTime     @default(now())
  asset     ChapterAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag       AssetTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([assetId, tagId])
  @@index([assetId])
  @@index([tagId])
  @@map("asset_tagging")
}

model ChapterGenreTag {
  id        String       @id @default(uuid())
  chapterId String
  genre     ChapterGenre
  createdAt DateTime     @default(now())
  chapter   Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([chapterId, genre])
  @@index([chapterId])
  @@index([genre])
  @@map("chapter_genre_tags")
}

model Bundle {
  id                  String       @id @default(uuid())
  name                String
  description         String?
  slug                String       @unique
  amountCents         Int
  originalAmountCents Int
  currency            String       @default("EUR")
  isActive            Boolean      @default(true)
  displayOrder        Int?
  imageUrl            String?
  validFrom           DateTime?
  validUntil          DateTime?
  maxPurchases        Int?
  purchaseCount       Int          @default(0)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  createdBy           String?
  items               BundleItem[]

  @@index([isActive, validFrom, validUntil])
  @@index([slug])
  @@map("bundles")
}

model BundleItem {
  id           String   @id @default(uuid())
  bundleId     String
  type         String
  chapterId    String?
  volumeFrom   Int?
  volumeTo     Int?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  bundle       Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  chapter      Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([bundleId])
  @@index([chapterId])
  @@map("bundle_items")
}

model Constellation {
  id           String                      @id @default(uuid())
  slug         String                      @unique
  name         String
  description  String?
  iconKey      String?
  colorKey     String?
  createdAt    DateTime                    @default(now())
  badges       Badge[]
  chapterTags  ChapterConstellation[]
  rewards      RewardUnlock[]
  userProgress UserConstellationProgress[]
  volumeTags   VolumeConstellation[]

  @@map("constellations")
}

model ChapterConstellation {
  id              String        @id @default(uuid())
  chapterId       String
  constellationId String
  weight          Int           @default(100)
  chapter         Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  constellation   Constellation @relation(fields: [constellationId], references: [id], onDelete: Cascade)

  @@unique([chapterId, constellationId])
  @@index([chapterId])
  @@index([constellationId])
  @@map("chapter_constellations")
}

model VolumeConstellation {
  id              String        @id @default(uuid())
  volumeId        String
  constellationId String
  weight          Int           @default(100)
  constellation   Constellation @relation(fields: [constellationId], references: [id], onDelete: Cascade)
  volume          Volume        @relation(fields: [volumeId], references: [id], onDelete: Cascade)

  @@unique([volumeId, constellationId])
  @@index([volumeId])
  @@index([constellationId])
  @@map("volume_constellations")
}

model UserProgress {
  id        String   @id @default(uuid())
  userId    String   @unique
  level     Int      @default(1)
  xpFeu     Int      @default(0)
  xpAme     Int      @default(0)
  xpOmbre   Int      @default(0)
  feuPct    Int      @default(0)
  amePct    Int      @default(0)
  ombrePct  Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

model UserConstellationProgress {
  id              String        @id @default(uuid())
  userId          String
  constellationId String
  percent         Int           @default(0)
  reached25       Boolean       @default(false)
  reached50       Boolean       @default(false)
  reached75       Boolean       @default(false)
  reached100      Boolean       @default(false)
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())
  constellation   Constellation @relation(fields: [constellationId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, constellationId])
  @@index([constellationId])
  @@map("user_constellation_progress")
}

model Badge {
  id              String         @id @default(uuid())
  type            BadgeType
  code            String         @unique
  name            String
  description     String?
  iconKey         String?
  constellationId String?
  minLevel        Int?
  thresholdPct    Int?
  createdAt       DateTime       @default(now())
  constellation   Constellation? @relation(fields: [constellationId], references: [id])
  users           UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@index([badgeId])
  @@map("user_badges")
}

model RewardUnlock {
  id              String             @id @default(uuid())
  type            RewardUnlockType
  code            String             @unique
  title           String
  teaser          String?
  payload         Json?
  chapterId       String?
  volumeId        String?
  constellationId String?
  createdAt       DateTime           @default(now())
  chapter         Chapter?           @relation(fields: [chapterId], references: [id])
  constellation   Constellation?     @relation(fields: [constellationId], references: [id])
  volume          Volume?            @relation(fields: [volumeId], references: [id])
  users           UserRewardUnlock[]

  @@index([chapterId])
  @@index([volumeId])
  @@index([constellationId])
  @@map("reward_unlocks")
}

model UserRewardUnlock {
  userId         String
  rewardUnlockId String
  unlockedAt     DateTime     @default(now())
  reward         RewardUnlock @relation(fields: [rewardUnlockId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, rewardUnlockId])
  @@index([rewardUnlockId])
  @@map("user_reward_unlocks")
}

model SupportClaim {
  id          String               @id @default(uuid())
  userId      String
  category    SupportClaimCategory
  subject     String
  message     String
  status      SupportClaimStatus   @default(OPEN)
  adminNote   String?
  respondedBy String?
  respondedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("support_claims")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum ChapterStatus {
  DRAFT
  IN_PROGRESS
  PUBLISHED
}

enum VolumeStatus {
  DRAFT
  IN_PROGRESS
  PUBLISHED
}

enum Perspective {
  NARRATOR
  PROTAGONIST
}

enum OrderType {
  CHAPTER
  PREORDER
  BUNDLE
  COLORING
  VERSION_PACK
  VOLUME
  PERSPECTIVE
}

enum OrderStatus {
  PAID
  REFUNDED
  PENDING
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  TRIALING
  INCOMPLETE
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum RefundType {
  FULL
  PARTIAL
}

enum EntitlementSource {
  PURCHASE
  PREORDER
  PACK
  SUBSCRIPTION
  PROMOTION
}

enum UnlockTriggeredBy {
  WAIT
  PURCHASE
}

enum PriceScope {
  VOLUME
  CHAPTER
  EPILOGUE
  POV
  COLORING
  BUNDLE
  SUBSCRIPTION
  POV_CHAPTER
  POV_VOLUME
}

enum PromotionType {
  PERCENT
  FIXED
  FREE
}

enum PromotionTargetType {
  ALL_USERS
  SPECIFIC_USERS
  CRITERIA_BASED
}

enum AssetKind {
  IMAGE
  COLORING_PAGE
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BadgeType {
  PROGRESSION
  CONSTELLATION
  STYLE
  EDITORIAL
}

enum RewardUnlockType {
  REVELATION
  BONUS_EXCERPT
  ALT_COVER
  PLAYLIST
  AUTHOR_NOTE
}

enum SupportClaimCategory {
  TECHNICAL
  BILLING
  CONTENT
  OTHER
}

model CustomStoryRequest {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id])

  // Protagoniste
  protagonistName String
  photoAssetIds String[]

  // Personnalité
  description String
  selectedGenres String[]
  explicitLevel String

  // Niveaux Émotionnels
  niveauIntensitee Int @db.SmallInt
  niveauDouceur Int @db.SmallInt
  niveauDanger Int @db.SmallInt
  niveauTransformation Int @db.SmallInt

  // Structure Histoire
  volumeProposals VolumeProposal[]
  storyEnding String
  storyEndingCustom String? @db.Text

  // Contact & Consentements
  email String
  rgpdConsent Boolean @default(false)
  ccpaConsent Boolean @default(false)

  // Modération & Traçabilité
  status String @default("PENDING")
  rejectionReason String?
  rejectionNotes String?

  // Sécurité & Analytics
  userIp String
  userMacAddress String?
  userLocation String?
  userAgent String

  // Timestamps
  submittedAt DateTime @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  dataRetentionDeletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  musedChapter ChapterMuse?

  @@index([userId])
  @@index([status])
  @@index([submittedAt])
  @@index([dataRetentionDeletedAt])
  @@map("custom_story_requests")
}

model VolumeProposal {
  id String @id @default(cuid())
  customStoryRequestId String
  customStoryRequest CustomStoryRequest @relation(fields: [customStoryRequestId], references: [id], onDelete: Cascade)

  volumeNumber Int @db.SmallInt
  proposedLocation String
  proposedOrientation String
  proposedTwist String

  @@unique([customStoryRequestId, volumeNumber])
  @@map("volume_proposals")
}

enum SupportClaimStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ChapterGenre {
  PASSIONS_CHARNELLES
  ROMANCES_TENDRES
  MYSTERIES_SENSUELS
  INTERDITS
  CONQUETES
  REVES_SECRETS
  PASSION_BRUTALE
  AMOUR_COMPLIQUE
  DESIR_NOCTURNE
  LIBERATION
  DECOUVERTE_DE_SOI
  INTIMITE_PSYCHOLOGIQUE
  EVEIL_DU_DESIR
  RELATIONS_TRANSFORMATRICES
  MEMOIRE_DU_CORPS
}
