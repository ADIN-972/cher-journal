generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  USER
  ADMIN
  SUPERADMIN
}

enum ChapterStatus {
  DRAFT
  IN_PROGRESS
  PUBLISHED
}

enum VolumeStatus {
  DRAFT
  IN_PROGRESS
  PUBLISHED
}

enum Perspective {
  NARRATOR
  PROTAGONIST
}

enum OrderType {
  CHAPTER
  PREORDER
  BUNDLE
  COLORING
  VERSION_PACK
}

enum OrderStatus {
  PAID
  REFUNDED
  PENDING
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum RefundType {
  FULL
  PARTIAL
}

enum EntitlementVersionScope {
  BASE
  ALL
}

enum EntitlementSource {
  PURCHASE
  PREORDER
  PACK
  SUBSCRIPTION
}

enum UnlockTriggeredBy {
  WAIT
  PURCHASE
}

// Pricing scopes covering per-volume, per-chapter, add-ons, bundles, and subscriptions
enum PriceScope {
  VOLUME
  CHAPTER
  EPILOGUE
  POV
  COLORING
  BUNDLE
  SUBSCRIPTION
}

enum PromotionType {
  PERCENT
  FIXED
  FREE
}

enum PromotionTargetType {
  ALL_USERS
  SPECIFIC_USERS
  CRITERIA_BASED
}

enum AssetKind {
  IMAGE
  COLORING_PAGE
}

model User {
  id                  String      @id @default(uuid())
  publicId            String      @unique @default(uuid())
  email               String      @unique
  passwordHash        String
  firstName           String
  lastName            String
  username            String?     @unique
  status              UserStatus  @default(ACTIVE)
  role                UserRole    @default(USER)
  createdAt           DateTime    @default(now())
  sessions            Session[]
  orders              Order[]
  entitlements        Entitlement[]
  unlocks             Unlock[]
  reads               VolumeRead[]
  appliedPromotions   AppliedPromotion[]
  auditLogs           AuditLog[]

  @@map("users")
}

model Session {
  id            String   @id @default(uuid())
  userId        String
  sessionToken  String   @unique
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  ipHash        String?
  userAgentHash String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Chapter {
  id              String         @id @default(uuid())
  title           String
  protagonistName String
  status          ChapterStatus  @default(DRAFT)
  publishedAt     DateTime?
  scheduledFor    DateTime?      // Date de publication programmée
  coverAssetId    String?
  isArchived      Boolean        @default(false)
  coverAsset      ChapterAsset?  @relation("ChapterCover", fields: [coverAssetId], references: [id])
  createdAt       DateTime       @default(now())
  assets          ChapterAsset[]
  volumes         Volume[]
  entitlements    Entitlement[]
  unlocks         Unlock[]
  reads           VolumeRead[]
  priceOverride   ChapterPriceOverride?

  @@index([scheduledFor])
  @@map("chapters")
}

model Volume {
  id                   String          @id @default(uuid())
  chapterId            String
  volumeNumber         Int
  title                String
  status               VolumeStatus    @default(DRAFT)
  waitDuration         BigInt          @default(0)
  isFinalPaywall       Boolean         @default(false)
  isFree               Boolean         @default(false)
  publishedAt          DateTime?
  scheduledFor         DateTime?       // Date de publication programmée
  illustrationAssetId  String?
  illustrationAsset    ChapterAsset?   @relation("VolumeIllustration", fields: [illustrationAssetId], references: [id])
  createdAt            DateTime        @default(now())
  chapter              Chapter         @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  versions             VolumeVersion[]

  @@unique([chapterId, volumeNumber])
  @@index([chapterId])
  @@index([scheduledFor])
  @@map("volumes")
}

model VolumeVersion {
  id                   String         @id @default(uuid())
  volumeId             String
  perspective          Perspective
  textBlobId           String?
  illustrationAssetId  String?
  illustrationAsset    ChapterAsset?  @relation("VersionIllustration", fields: [illustrationAssetId], references: [id])
  text                 String?
  isAutoText           Boolean        @default(true)
  characterCount       Int            @default(0)
  createdAt            DateTime       @default(now())
  volume               Volume         @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  textBlob             EncryptedBlob? @relation("VersionText", fields: [textBlobId], references: [id], onDelete: SetNull)
  assets               VersionAsset[]

  @@unique([volumeId, perspective])
  @@index([volumeId])
  @@map("volume_versions")
}

model VersionAsset {
  id              String         @id @default(uuid())
  volumeVersionId String
  assetOrder      Int
  chapterAssetId  String
  createdAt       DateTime       @default(now())
  volumeVersion   VolumeVersion  @relation(fields: [volumeVersionId], references: [id], onDelete: Cascade)
  chapterAsset    ChapterAsset   @relation(fields: [chapterAssetId], references: [id], onDelete: Restrict)

  @@unique([volumeVersionId, assetOrder])
  @@index([volumeVersionId])
  @@index([chapterAssetId])
  @@map("version_assets")
}

model ChapterAsset {
  id                  String      @id @default(uuid())
  chapterId           String
  kind                AssetKind   @default(IMAGE)
  label               String?
  objectKey           String
  thumbnailObjectKey  String?
  mimeType            String
  sizeBytes           Int
  width               Int?
  height              Int?
  sha256              String?
  version             Int         @default(1)       // Version de l'asset
  originalAssetId     String?                       // Si c'est une version, référence à l'original
  originalAsset       ChapterAsset? @relation("AssetVersions", fields: [originalAssetId], references: [id], onDelete: SetNull)
  versions            ChapterAsset[] @relation("AssetVersions")
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @default(now()) @updatedAt
  chapter             Chapter     @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  coverFor            Chapter[]   @relation("ChapterCover")
  illustrationFor     Volume[]    @relation("VolumeIllustration")
  versionIllustrationFor VolumeVersion[] @relation("VersionIllustration")
  versionAssets       VersionAsset[]
  tags                AssetTagging[]

  @@index([chapterId])
  @@index([sha256])
  @@index([originalAssetId])
  @@map("chapter_assets")
}

model Order {
  id                      String      @id @default(uuid())
  userId                  String
  type                    OrderType
  status                  OrderStatus @default(PENDING)
  provider                String?
  providerSessionId       String?
  providerPaymentIntentId String?
  currency                String?
  amountTotal             Int?
  appliedPriceFreeToRead  Int?        // Prix appliqué au moment de la commande
  appliedPricePaywall     Int?
  appliedPriceEpilogue    Int?
  appliedPriceSchemaId    String?     // Quel schéma était actif?
  appliedPromotionId      String?     // Quelle promo a été appliquée?
  createdAt               DateTime    @default(now())
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  refunds                 Refund[]

  @@index([userId])
  @@map("orders")
}

model Refund {
  id                    String       @id @default(uuid())
  orderId               String
  amountRefunded        Int          // Amount in cents
  currency              String       @default("eur")
  type                  RefundType
  status                RefundStatus @default(PENDING)
  reason                String?      // Admin reason for refund
  notes                 String?      // Internal notes
  providerRefundId      String?      // Stripe refund ID
  revokeEntitlements    Boolean      @default(true) // Should we revoke access?
  refundedBy            String?      // Admin user ID who processed refund
  refundedAt            DateTime     @default(now())
  processedAt           DateTime?    // When Stripe confirmed
  failureReason         String?      // If failed, why?
  order                 Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

model Entitlement {
  id           String                   @id @default(uuid())
  userId       String
  chapterId    String
  volumeFrom   Int
  volumeTo     Int
  versionScope EntitlementVersionScope  @default(BASE)
  source       EntitlementSource
  grantedAt    DateTime                 @default(now())
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter      Chapter                  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([userId, chapterId])
  @@map("entitlements")
}

model Unlock {
  id           String            @id @default(uuid())
  userId       String
  chapterId    String
  volumeNumber Int
  unlocksAt    DateTime
  triggeredBy  UnlockTriggeredBy
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter      Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId, volumeNumber])
  @@index([userId, chapterId])
  @@map("unlocks")
}

model VolumeRead {
  id            String   @id @default(uuid())
  userId        String
  chapterId     String
  volumeNumber  Int
  firstOpenedAt DateTime @default(now())
  completedAt   DateTime?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@unique([userId, chapterId, volumeNumber])
  @@index([userId, chapterId])
  @@map("volume_reads")
}

model EncryptedBlob {
  id         String          @id @default(uuid())
  ownerId    String
  purpose    String
  cipherText Bytes
  iv         Bytes
  tag        Bytes
  wrappedDek Bytes
  alg        String
  version    Int
  createdAt  DateTime @default(now())
  versionTexts VolumeVersion[] @relation("VersionText")

  @@index([ownerId, purpose])
  @@map("encrypted_blobs")
}

model WebhookEvent {
  id         String   @id @default(uuid())
  provider   String
  eventId    String   @unique
  type       String
  receivedAt DateTime @default(now())

  @@map("webhook_events")
}

model Setting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Price {
  id          String       @id @default(uuid())
  scope       PriceScope
  refId       String?      // volumeId, chapterId, bundleId, etc.
  amountCents Int
  currency    String       @default("EUR")
  createdAt   DateTime     @default(now())

  promotions  Promotion[]
  history     PriceHistory[]

  @@index([scope, refId])
  @@map("prices")
}

model PriceHistory {
  id             String    @id @default(uuid())
  priceId        String
  price          Price     @relation(fields: [priceId], references: [id], onDelete: Cascade)
  oldAmountCents Int
  newAmountCents Int
  currency       String    @default("EUR")
  changedAt      DateTime  @default(now())
  changedBy      String?   // ID de l'admin qui a fait la modification
  reason         String?   // Raison du changement (optionnel)

  @@index([priceId, changedAt])
  @@index([changedAt])
  @@map("price_history")
}

model Promotion {
  id           String         @id @default(uuid())
  name         String         @default("Promotion") // Nom de la promotion
  description  String?        // Description
  scope        PriceScope
  refId        String?
  type         PromotionType
  value        Int?           // percent or fixed cents depending on type
  startsAt     DateTime
  endsAt       DateTime
  maxUses      Int?
  perUserLimit Int?
  isActive     Boolean        @default(true)
  code         String?        @unique // Code promo (ex: "SUMMER2024", optionnel)

  // Ciblage des utilisateurs
  targetType   PromotionTargetType @default(ALL_USERS)
  targetUserIds String[]       @default([]) // Liste d'IDs utilisateurs (pour SPECIFIC_USERS)
  targetCriteria Json?         // Critères de ciblage (pour CRITERIA_BASED)

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @default(now()) @updatedAt
  createdBy    String?        // ID de l'admin qui a créé la promo

  priceId      String?
  price        Price?         @relation(fields: [priceId], references: [id])
  applied      AppliedPromotion[]

  @@index([scope, refId])
  @@index([priceId])
  @@index([targetType])
  @@index([isActive, startsAt, endsAt])
  @@index([code])
  @@map("promotions")
}

model AppliedPromotion {
  id          String     @id @default(uuid())
  promotionId String
  userId      String
  appliedAt   DateTime   @default(now())

  promotion   Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([promotionId])
  @@map("applied_promotions")
}

// ============= PRICE SCHEMAS & OVERRIDES =============

model PriceSchema {
  id              String    @id @default(uuid())
  name            String
  description     String?
  
  // Prix par type de volume (en centimes)
  priceFreeToRead Int       @default(199)
  pricePaywall    Int       @default(299)
  priceEpilogue   Int       @default(399)
  
  // Metadata
  isActive        Boolean   @default(true)
  appliedFrom     DateTime  @default(now())
  appliedTo       DateTime?
  createdAt       DateTime  @default(now())
  createdBy       String    // admin user ID
  
  // Relations
  chapterOverrides ChapterPriceOverride[]
  
  @@index([isActive])
  @@index([appliedFrom])
  @@map("price_schemas")
}

model ChapterPriceOverride {
  id              String    @id @default(uuid())
  
  // Relation
  chapterId       String    @unique
  chapter         Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  
  // Schéma de base
  schemaId        String
  schema          PriceSchema @relation(fields: [schemaId], references: [id])
  
  // Overrides (optionnels - NULL = utiliser le prix du schéma)
  priceFreeToRead Int?
  pricePaywall    Int?
  priceEpilogue   Int?
  
  // Raison de l'exception
  reason          String?
  
  // Metadata
  isActive        Boolean   @default(true)
  appliedFrom     DateTime  @default(now())
  appliedTo       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([schemaId])
  @@index([isActive])
  @@map("chapter_price_overrides")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String   // ID de l'admin qui a effectué l'action
  action      String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  resource    String   // User, Chapter, Order, Price, Promotion, etc.
  resourceId  String?  // ID de la ressource concernée
  metadata    Json?    // Détails supplémentaires (old values, new values, etc.)
  ip          String?  // Adresse IP
  userAgent   String?  // User agent
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

// Configuration système pour paiements et autres paramètres
model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique // Ex: "stripe.publishable_key", "stripe.secret_key"
  value       String?  // Valeur (peut être NULL pour secrets non renseignés)
  category    String   // PAYMENT, EMAIL, GENERAL, SECURITY, etc.
  type        String   // STRING, BOOLEAN, NUMBER, JSON, SECRET
  description String?  // Description de la configuration
  isEncrypted Boolean  @default(false) // Si la valeur est chiffrée
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // ID de l'admin qui a modifié

  @@index([category])
  @@map("system_configs")
}

// ============= ASSET MANAGEMENT SYSTEM =============

model AssetTag {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  color       String?        // Couleur hexadécimale pour l'affichage (ex: #FF5733)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  assets      AssetTagging[]

  @@map("asset_tags")
}

model AssetTagging {
  id        String       @id @default(uuid())
  assetId   String
  tagId     String
  createdAt DateTime     @default(now())
  asset     ChapterAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tag       AssetTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([assetId, tagId])
  @@index([assetId])
  @@index([tagId])
  @@map("asset_tagging")
}
