{
  "permissions": {
    "allow": [
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run prisma:*)",
      "Bash(npx prisma:*)",
      "Bash(npx vitest:*)",
      "Bash(npx jest:*)",
      "Bash(npx playwright:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(dir:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "PowerShell(Get-Content:*)",
      "PowerShell(Get-ChildItem:*)",
      "PowerShell(Test-Path:*)",
      "PowerShell(Select-String:*)",
      "PowerShell(npm:*)",
      "PowerShell(node:*)",
      "PowerShell(npx:*)",
      "WebSearch",
      "Bash(timeout /t 5)",
      "Bash(findstr:*)",
      "Bash(del update-volume-status.ts)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git rm:*)",
      "Bash(if [ -f \"nul\" ])",
      "Bash(then rm -f nul)",
      "Bash(fi)",
      "Bash(git mv:*)",
      "Bash(git reset:*)",
      "Bash(curl:*)",
      "Bash(netstat:*)",
      "Bash(taskkill:*)",
      "Bash(tasklist:*)",
      "Bash(timeout /t 3)",     
      "Bash(npx prisma migrate dev:*)",
      "Bash(npx prisma db seed)",
      "Bash(python:*)",
      "Bash(timeout /t 3 /nobreak)",
      "Bash(ping:*)",
      "Bash(CORS_ORIGINS=\"http://localhost:5173,http://localhost:5174,http://localhost:5175,http://192.168.1.23:5173,http://192.168.1.23:5174,http://192.168.1.23:5175\" npm run dev:*)",
      "Bash(npx prisma studio:*)",
      "Bash(npx prisma migrate:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npm run dev:backend:*)",
      "Bash(taskkill //F //PID 142320)",
      "Bash(ipconfig:*)",
      "Bash(netsh advfirewall firewall show rule:*)",
      "Bash(node -e:*)",
      "Bash(timeout:*)",
      "Bash(npx tsx:*)",
      "Bash(npm run verify:translations:*)",
      "Bash(npm run dev:web:*)",
      "Bash(npm run sync:translations:*)",
      "Bash(npm run backup:db:*)",
      "Bash(npm run seed:*)",
      "Bash(npx prisma db seed:*)",
      "Bash(npx tsc:*)",
      "Bash(npm run prisma:generate:*)",
      "Bash(npx prisma validate:*)",
      "Bash(npm run build:backend:*)",
      "Bash(npm ls:*)"
    ],
    "env": {
      "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
      "ENABLE_METRICS_REPORTER": "1",
      "ENABLE_BACKGROUND_TASKS": "1"
    }
  },
  "autoApprove": {
    "patterns": ["git status", "git log", "git diff"]
  },
  "restrictions": {
    "requireApproval": [
      "npm run prisma:migrate:deploy",
      "npm run prisma:db:push",
      "npx prisma db push",
      "git push",
      "git commit",
      "rm -rf",
      "Remove-Item -Recurse"
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "example-skills@anthropic-agent-skills": true
  },
  "preferredNotifChannel": "terminal_bell",
  "environment": {
    "backgroundTasks": {
      "BG_TASK_ENABLED": "true",
      "BG_TASK_QUEUE_SIZE": "1000",
      "BG_TASK_CONCURRENCY": "10",
      "BG_TASK_TIMEOUT": "300000",
      "BG_TASK_RETRY_ATTEMPTS": "3",
      "BG_TASK_RETRY_DELAY": "5000"
    },
    "otel": {
      "OTEL_ENABLED": "true",
      "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4317",
      "OTEL_EXPORTER_OTLP_PROTOCOL": "grpc",
      "OTEL_SERVICE_NAME": "cher-journal-api",
      "OTEL_SERVICE_VERSION": "1.0.0",
      "OTEL_RESOURCE_ATTRIBUTES": "environment=development,team=platform",
      "OTEL_TRACES_EXPORTER": "otlp",
      "OTEL_METRICS_EXPORTER": "otlp",
      "OTEL_LOGS_EXPORTER": "otlp",
      "OTEL_PROPAGATORS": "tracecontext,baggage"
    },
    "metrics": {
      "METRICS_ENABLED": "true",
      "METRICS_PORT": "9090",
      "METRICS_ENDPOINT": "/metrics",
      "METRICS_INTERVAL": "60000",
      "METRICS_HISTOGRAM_BUCKETS": "0.1,0.5,1,2,5,10,20,50,100,500,1000",
      "METRICS_INCLUDE_DEFAULT": "true",
      "METRICS_INCLUDE_GC": "true",
      "METRICS_INCLUDE_PROCESS": "true",
      "METRICS_INCLUDE_HTTP": "true"
    },
    "telemetry": {
      "TELEMETRY_ENABLED": "true",
      "TELEMETRY_INTERVAL": "300000",
      "TELEMETRY_BATCH_SIZE": "512",
      "TELEMETRY_TIMEOUT": "30000",
      "TELEMETRY_ENDPOINT": "http://localhost:4318/v1/logs",
      "TELEMETRY_LOG_LEVEL": "info",
      "TELEMETRY_SAMPLE_RATE": "1.0",
      "TELEMETRY_DEBUG": "false"
    }
  }
}
