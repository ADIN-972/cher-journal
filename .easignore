# Symlinks (cause EPERM on Windows)
.trunk

# Git
.git

# Expo
.expo

# Native build folders (regenerated by prebuild)
android
ios

# Node modules (EAS runs npm install during build)
node_modules

# Other apps (not needed for mobile build)
apps/admin
apps/backend
apps/web

# Packages source (only compiled output needed)
packages/*/src

# Tests
__tests__

# Logs & env
*.log
.env.local

# Claude/IDE
.claude
.vscode
